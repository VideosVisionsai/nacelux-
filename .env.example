# Supabase PostgreSQL connection string (server-side only).
# Prefer the Supabase Session Pooler URI for long-running IPv4 environments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_PROVIDER=postgresql
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

# Supabase Auth (server-side gateway)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# The anon/publishable key is used only by the NACELUX backend in this architecture.
SUPABASE_ANON_KEY=replace-with-project-anon-key
AUTH_COOKIE_SECURE=true
AUTH_REDIRECT_URL=https://your-nacelux-domain.example/reset-password

# LBR/RESA controlled public-page connector
LBR_RESA_ENABLED=false
LBR_RESA_HEADLESS=true
LBR_RESA_TIMEOUT_MS=45000
LBR_RESA_MIN_INTERVAL_SECONDS=8
LBR_USER_AGENT=NACELUX/1.0 (+https://your-domain.example/data-policy; contact@example.com)
LBR_RESA_ARTIFACT_DIR=data/resa-artifacts
LBR_PDF_MAX_BYTES=52428800
LBR_PDF_ALLOWED_HOSTS=www.lbr.lu,lbrcontent.public.lu

# Storage: local for development, supabase for production
DOCUMENT_STORAGE_PROVIDER=local
LOCAL_DOCUMENT_STORAGE_DIR=data/document-storage
SUPABASE_STORAGE_BUCKET=resa-documents
# Server secret: never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key

# PDF text extraction and OCR fallback
PDF_EXTRACTION_MAX_PAGES=100
PDF_TEXT_MIN_CHARS_PER_PAGE=80
PDF_TEXT_MIN_QUALITY=0.55
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=fra+deu+eng
PDF_OCR_DPI=300
PDF_OCR_TIMEOUT_SECONDS=90

# Official Eurostat/ShowVoc NACE Rev. 2.1 RDF distribution
NACE21_SOURCE_URL=https://showvoc.op.europa.eu/semanticturkey/downloads/ESTAT_Statistical_Classification_of_Economic_Activities_in_the_European_Community_Rev._2.1._%28NACE_2.1%29/distributions/NACE_Rev_2.1.zip
NACE21_ARTIFACT_DIR=data/nace-imports
NACE21_LANGUAGES=fr,de,en

# Website discovery — official documented search APIs only
SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
WEBSITE_DISCOVERY_MIN_CONFIDENCE=0.72
WEBSITE_FETCH_TIMEOUT_SECONDS=10
WEBSITE_FETCH_MAX_BYTES=1000000

# Google Business / Places API (New)
GOOGLE_PLACES_API_KEY=

# SEO audit
SEO_FETCH_TIMEOUT_SECONDS=15
SEO_FETCH_MAX_BYTES=3000000
PAGESPEED_API_KEY=

# Compliant People Engine
PEOPLE_PROFILE_MIN_CONFIDENCE=0.82
PEOPLE_RETENTION_DAYS=365
PEOPLE_MAX_SEARCHES_PER_RUN=10

# Business Signals rules
SIGNAL_NEW_COMPANY_DAYS=90
SIGNAL_RECENT_INCORPORATION_DAYS=30
SIGNAL_WEAK_SEO_THRESHOLD=50
SIGNAL_WEAK_WEBSITE_THRESHOLD=40
SIGNAL_HIGH_VALUE_NICHE_THRESHOLD=80
SIGNAL_RULE_VERSION=1.0

# Migration behavior
MIGRATIONS_DIR=database/migrations
# Keep startup read-only unless a planned deployment explicitly enables migrations.
AUTO_MIGRATE=false
MIGRATE_SQLITE_DATA=false
SQLITE_SOURCE_PATH=data/nacelux.db

# App
PORT=8000
NACELUX_ENV=production
